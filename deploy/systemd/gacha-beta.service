[Unit]
Description=Gacha MVP-1 closed-beta Telegram poller (NOT public)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=gacha
Group=gacha
WorkingDirectory=/opt/gacha/current
EnvironmentFile=/etc/gacha/beta.env
ExecStartPre=/opt/gacha/venv/bin/python -m gacha_core.beta_preflight --online
ExecStart=/opt/gacha/venv/bin/python -m gacha_core.telegram_runtime
Restart=on-failure
RestartSec=10
TimeoutStartSec=90
UMask=0077
StateDirectory=gacha
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
